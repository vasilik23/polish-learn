      {"id": "time-exercise-at-six", "prompt": "Spotkanie jest ___ szóstej.", "options": ["w", "o", "na"], "answer": "o", "explanation": "Точное время вводим предлогом o: o szóstej."},
      {"id": "time-exercise-on-monday", "prompt": "Kurs jest ___ poniedziałek.", "options": ["o", "w", "na"], "answer": "w", "explanation": "С днями недели употребляем w: w poniedziałek."},
